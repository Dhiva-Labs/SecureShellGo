#!/usr/bin/make -f

# Launchpad's PPA build farm has no outbound network access, so the Flutter
# SDK and pub cache are vendored under packaging/vendor/ and extracted into
# build-scoped directories here. See packaging/vendor/README for how the
# tarballs are produced.
FLUTTER_VERSION := 3.44.6
FLUTTER_ENGINE_VERSION := 83675ed27633283e7fc296c8bca22e841224c096

FLUTTER_ROOT := $(CURDIR)/.flutter
FLUTTER_TARBALL := $(CURDIR)/packaging/vendor/flutter-$(FLUTTER_VERSION)-linux-slim.tar.xz
PUB_CACHE_TARBALL := $(CURDIR)/packaging/vendor/pub-cache-$(FLUTTER_VERSION).tar.xz

export PATH := $(FLUTTER_ROOT)/bin:$(PATH)
export HOME := $(CURDIR)/debian/.home
export PUB_CACHE := $(CURDIR)/.pub-cache
# Tell the flutter tool which engine artifacts it already has, so it doesn't
# try to derive the version from a real git history (there isn't one — the
# vendored SDK ships a minimal .git shim instead).
export FLUTTER_PREBUILT_ENGINE_VERSION := $(FLUTTER_ENGINE_VERSION)

%:
	dh $@

override_dh_auto_build:
	mkdir -p $(HOME)
	if [ ! -x "$(FLUTTER_ROOT)/bin/flutter" ]; then \
		rm -rf $(CURDIR)/flutter $(FLUTTER_ROOT); \
		tar --no-same-owner -xJf $(FLUTTER_TARBALL) -C $(CURDIR); \
		mv $(CURDIR)/flutter $(FLUTTER_ROOT); \
	fi
	if [ ! -d "$(PUB_CACHE)/hosted" ]; then \
		mkdir -p $(PUB_CACHE); \
		tar --no-same-owner -xJf $(PUB_CACHE_TARBALL) -C $(PUB_CACHE); \
	fi
	$(FLUTTER_ROOT)/bin/flutter --disable-analytics config --no-analytics --no-cli-animations
	# Belt-and-braces to keep pub genuinely offline. All three exist
	# because the ~noble2 build failed with "Got socket error trying to
	# find package test at https://pub.dev." under --offline — meaning
	# pub decided to re-resolve rather than trust pubspec.lock, and its
	# offline-fallback fell through to a network call anyway.
	#
	# 1) Touch the lockfile: dpkg-source preserves mtimes, so a version
	#    bump can leave pubspec.yaml newer than pubspec.lock and trigger
	#    a "lockfile stale" re-resolution.
	# 2) Strip `resolution: workspace` from every vendored pubspec: ten
	#    of our transitive deps (test_api, meta, ffi, win32...) declare
	#    it and it makes pub pull those packages' dev_dependencies
	#    (`test: any`, `test_core: any`) as if they were monorepo
	#    members. Those packages are not vendored, so pub tries to
	#    fetch them.
	# 3) Use `flutter pub get --offline` (NOT `dart pub get`): the
	#    dart CLI doesn't set up FLUTTER_ROOT the way the flutter
	#    wrapper does, so `dart pub get` can't resolve the
	#    `flutter_test` dev dep (comes from `sdk: flutter`, not
	#    pub.dev). ~noble4 tried `dart pub get --enforce-lockfile`
	#    and hit "the Flutter SDK is not available." `flutter pub
	#    get --offline` succeeded in ~noble3 for the app's resolution
	#    step; only the build step failed, and that was because
	#    resolution: workspace wasn't stripped from .flutter/packages.
	#    With the strip covering both cache and SDK packages,
	#    `flutter pub get --offline` is the right knob.
	touch pubspec.lock
	# Strip `resolution: workspace` from BOTH the vendored pub cache
	# AND the vendored Flutter SDK's own package pubspecs. flutter_
	# test, flutter_localizations and integration_test all declare it,
	# and our app depends on flutter_test as a dev dep — so both the
	# `flutter pub get` step and the later `flutter build linux` step
	# walk into workspace expansion without this.
	# The sed MUST NOT advance each pubspec.yaml's mtime: the flutter
	# wrapper rebuilds its own tool (via an online `pub upgrade`) when
	# flutter_tools/pubspec.yaml is newer than its pubspec.lock — that
	# was failure mode number four, caught in a local network-isolated
	# rehearsal before it wasted another Launchpad cycle. touch -r
	# against a stamp file restores the original mtime after editing.
	find $(PUB_CACHE) $(FLUTTER_ROOT)/packages -name pubspec.yaml \
		-exec sh -c 'for f; do \
			touch -r "$$f" "$$f.mtime-stamp"; \
			sed -i "/^resolution: workspace/d" "$$f"; \
			touch -r "$$f.mtime-stamp" "$$f"; \
			rm -f "$$f.mtime-stamp"; \
		done' - {} +
	$(FLUTTER_ROOT)/bin/flutter pub get --offline
	$(FLUTTER_ROOT)/bin/flutter build linux --release --no-pub

override_dh_auto_test:
	# The Dart/Flutter test suite needs a Flutter engine and a display; it
	# runs in CI, not at package build time.

override_dh_dwz:
	# The Flutter Linux shared libraries and the AOT-compiled application
	# binary don't ship .debug_info in the form dwz expects, so
	# dh_dwz fails outright. Skip DWARF compression for this package.

override_dh_strip:
	# libflutter_linux_gtk.so and the Flutter engine artifacts ship the
	# exact binaries Google/Flutter tested against — stripping them here
	# would produce a different .so than every other Flutter Linux
	# installation and defeat symbol-based crash reporting. Skip strip.

override_dh_auto_install:
	mkdir -p debian/secureshellgo/opt/secureshellgo
	cp -a build/linux/x64/release/bundle/. debian/secureshellgo/opt/secureshellgo/
	mkdir -p debian/secureshellgo/usr/bin
	install -m 0755 debian/secureshellgo.wrapper debian/secureshellgo/usr/bin/secureshellgo
	mkdir -p debian/secureshellgo/usr/share/applications
	install -m 0644 linux/secureshellgo.desktop debian/secureshellgo/usr/share/applications/secureshellgo.desktop
	mkdir -p debian/secureshellgo/usr/share/icons/hicolor/256x256/apps
	install -m 0644 linux/secureshellgo-256.png debian/secureshellgo/usr/share/icons/hicolor/256x256/apps/secureshellgo.png

override_dh_auto_clean:
	dh_auto_clean
	rm -rf .flutter .pub-cache build .dart_tool debian/.home
