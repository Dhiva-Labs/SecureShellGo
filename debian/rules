#!/usr/bin/make -f

# Launchpad's PPA build farm has no outbound network access, so the Flutter
# SDK and pub cache are vendored under packaging/vendor/ and extracted into
# build-scoped directories here. See packaging/vendor/README for how the
# tarballs are produced.
FLUTTER_VERSION := 3.44.6
FLUTTER_ENGINE_VERSION := 83675ed27633283e7fc296c8bca22e841224c096

FLUTTER_ROOT := $(CURDIR)/.flutter
FLUTTER_TARBALL := $(CURDIR)/packaging/vendor/flutter-$(FLUTTER_VERSION)-linux-slim.tar.xz
PUB_CACHE_TARBALL := $(CURDIR)/packaging/vendor/pub-cache-$(FLUTTER_VERSION).tar.xz

export PATH := $(FLUTTER_ROOT)/bin:$(PATH)
export HOME := $(CURDIR)/debian/.home
export PUB_CACHE := $(CURDIR)/.pub-cache
# Tell the flutter tool which engine artifacts it already has, so it doesn't
# try to derive the version from a real git history (there isn't one — the
# vendored SDK ships a minimal .git shim instead).
export FLUTTER_PREBUILT_ENGINE_VERSION := $(FLUTTER_ENGINE_VERSION)

%:
	dh $@

override_dh_auto_build:
	mkdir -p $(HOME)
	if [ ! -x "$(FLUTTER_ROOT)/bin/flutter" ]; then \
		rm -rf $(CURDIR)/flutter $(FLUTTER_ROOT); \
		tar -xJf $(FLUTTER_TARBALL) -C $(CURDIR); \
		mv $(CURDIR)/flutter $(FLUTTER_ROOT); \
	fi
	if [ ! -d "$(PUB_CACHE)/hosted" ]; then \
		mkdir -p $(PUB_CACHE); \
		tar -xJf $(PUB_CACHE_TARBALL) -C $(PUB_CACHE); \
	fi
	$(FLUTTER_ROOT)/bin/flutter --disable-analytics config --no-analytics --no-cli-animations
	$(FLUTTER_ROOT)/bin/flutter pub get --offline
	$(FLUTTER_ROOT)/bin/flutter build linux --release --no-pub

override_dh_auto_test:
	# The Dart/Flutter test suite needs a Flutter engine and a display; it
	# runs in CI, not at package build time.

override_dh_dwz:
	# The Flutter Linux shared libraries and the AOT-compiled application
	# binary don't ship .debug_info in the form dwz expects, so
	# dh_dwz fails outright. Skip DWARF compression for this package.

override_dh_strip:
	# libflutter_linux_gtk.so and the Flutter engine artifacts ship the
	# exact binaries Google/Flutter tested against — stripping them here
	# would produce a different .so than every other Flutter Linux
	# installation and defeat symbol-based crash reporting. Skip strip.

override_dh_auto_install:
	mkdir -p debian/secureshellgo/opt/secureshellgo
	cp -a build/linux/x64/release/bundle/. debian/secureshellgo/opt/secureshellgo/
	mkdir -p debian/secureshellgo/usr/bin
	install -m 0755 debian/secureshellgo.wrapper debian/secureshellgo/usr/bin/secureshellgo
	mkdir -p debian/secureshellgo/usr/share/applications
	install -m 0644 linux/secureshellgo.desktop debian/secureshellgo/usr/share/applications/secureshellgo.desktop
	mkdir -p debian/secureshellgo/usr/share/icons/hicolor/256x256/apps
	install -m 0644 linux/secureshellgo-256.png debian/secureshellgo/usr/share/icons/hicolor/256x256/apps/secureshellgo.png

override_dh_auto_clean:
	dh_auto_clean
	rm -rf .flutter .pub-cache build .dart_tool debian/.home
